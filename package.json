{
  "name": "gde-p0",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "npm run build:server && node --env-file-if-exists=.env scripts/dev.mjs",
    "typecheck": "tsc --noEmit",
    "test": "tsc -p tsconfig.tests.json && node --test .test-dist/tests/*.test.js",
    "test:http": "tsc -p tsconfig.tests.json && node scripts/test-http.mjs",
    "build": "npm run typecheck && vite build --config apps/web/vite.config.ts && npm run build:server",
    "start": "node --env-file-if-exists=.env dist/apps/server/src/main.js",
    "check": "npm run typecheck && npm test && npm run build",
    "build:server": "tsc -p tsconfig.server.json && node scripts/copy-packs.mjs",
    "validate:pack": "npm run build:server && node scripts/validate-pack.mjs"
  },
  "dependencies": {
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/node": "24.0.15",
    "@types/react": "18.3.23",
    "@types/react-dom": "18.3.7",
    "typescript": "5.8.3",
    "vite": "5.4.19"
  },
  "overrides": {
    "postcss": "8.5.6",
    "rollup": "4.45.1"
  }
}
